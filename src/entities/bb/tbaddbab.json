  { "type": "maxim_list", "items": [
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "de-DE", "route": "", "translation": {
      "citations": [
        { "citation": "kb1powff", "lang": "de", "page": "64", "plate": "", "url": "" }
      ], "text": "Der Himmel geize nicht mit seinen Wohltaten, noch die Erde mit ihren Schätzen"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "en-GB", "route": "", "translation": {
      "citations": [
        { "citation": "54q4hlvb", "lang": "en", "page": "115", "plate": "", "url": "" }
      ], "text": "Heaven grudges not its laws nor earth its treasures"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "en-GB", "route": "", "translation": {
      "citations": [
        { "citation": "rt5wnr81", "lang": "en", "page": "392", "plate": "", "url": "" },
        { "citation": "vat3hloi", "lang": "en", "page": "155", "plate": "", "url": "" },
        { "citation": "wzrb21p7", "lang": "en", "page": "", "plate": "", "url": "" }
      ], "text": "Heaven does not care too much about its rules, Earth does not care too much about its treasures"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "en-GB", "route": "", "translation": {
      "citations": [
        { "citation": "v793uyej", "lang": "en", "page": "11", "plate": "", "url": "" },
        { "citation": "yi4abjp5", "lang": "en", "page": "11", "plate": "", "url": "" }
      ], "text": "The heaven will not square its blessings, neither will the earth spare its treasures"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "fr-FR", "route": "", "translation": {
      "citations": [
        { "citation": "jwb4rurt", "lang": "fr", "page": "210", "plate": "", "url": "" },
        { "citation": "rqdaou3y", "lang": "fr", "page": "149", "plate": "", "url": "" }
      ], "text": "Le ciel ne sera pas avare de ses bienfaits, ni la terre de ses trésors"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "fr-FR", "route": "", "translation": {
      "citations": [
        { "citation": "g24mcucr", "lang": "fr", "page": "88", "plate": "", "url": "" },
        { "citation": "hq8n5n8z", "lang": "fr", "page": "71", "plate": "", "url": "" }
      ], "text": "Le Ciel dispense la Voie, la Terre n'est pas avare de ses trésors"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "ja-JP", "route": "", "translation": {
      "citations": [
        { "citation": "oicprxpn", "lang": "ja", "page": "15", "plate": "", "url": "" }
      ], "text": "天は摂理を惜しみなく一示し、地は宝物を惜しみなく与之る"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "ja-JP", "route": "", "translation": {
      "citations": [
        { "citation": "yo8nlu7d", "lang": "ja", "page": "128", "plate": "", "url": "" }
      ], "text": "天は自らの規則を気にすぎない、地は自らの宝について気にしすぎない"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "vi-VN", "route": "", "translation": {
      "citations": [
        { "citation": "ybuwdjsb", "lang": "vi", "page": "70", "plate": "", "url": "" }
      ], "text": "Trời không tiếc đạo - Đất không tiếc của"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "vi-VN", "route": "", "translation": {
      "citations": [
        { "citation": "4i4d9qv0", "lang": "vi", "page": "840", "plate": "", "url": "" }
      ], "text": "Trời chẳng tiếc lẽ phải, đất chẳng tiếc của báu"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "vi-VN", "route": "", "translation": {
      "citations": [
        { "citation": "52xcxi30", "lang": "vi", "page": "48", "plate": "", "url": "" },
        { "citation": "f9ewv5w2", "lang": "vi", "page": "169,203", "plate": "", "url": "" },
