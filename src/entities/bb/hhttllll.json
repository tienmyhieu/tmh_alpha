    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "zh-Hant", "route": "", "translation": {
      "citations": [
        { "citation": "rdvlih5h", "lang": "zh", "page": "", "plate": "", "url": "" }
