  { "type": "maxim_list", "items": [
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "de-DE", "route": "", "translation": {
      "citations": [
        { "citation": "kb1powff", "lang": "de", "page": "60", "plate": "", "url": "" }
      ], "text": "Menschen mit Tugenden achten, die Eitern lieben, den Frieden genießen, das Glück nutzen"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "en-GB", "route": "", "translation": {
      "citations": [
        { "citation": "rt5wnr81", "lang": "en", "page": "384", "plate": "", "url": "" },
        { "citation": "vat3hloi", "lang": "en", "page": "155", "plate": "", "url": "" },
        { "citation": "wzrb21p7", "lang": "en", "page": "", "plate": "", "url": "" }
      ], "text": "Appreciate the wise, love one’s parents, enjoy pleasure, benefit from gain"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "en-GB", "route": "", "translation": {
      "citations": [
        { "citation": "v793uyej", "lang": "en", "page": "10", "plate": "", "url": "" },
        { "citation": "yi4abjp5", "lang": "en", "page": "10", "plate": "", "url": "" }
      ], "text": "To estimate the men of parts and of uncommon vietus (to love and seek the wise men; to love one's parent to cherish ones relative, to enjoy peace; to profit by good fortune)"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "fr-FR", "route": "", "translation": {
      "citations": [
        { "citation": "17pzm9pe", "lang": "fr", "page": "180", "plate": "", "url": "" }
      ], "text": "Les parents du sage se réjouissent de sa prospérité"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "fr-FR", "route": "", "translation": {
      "citations": [
        { "citation": "jwb4rurt", "lang": "fr", "page": "207,430", "plate": "", "url": "" }
      ], "text": "Estimer les hommes d'un talent et d'une vertu peu ordinaire (aimer et rechercher les hommes sage); aimer ses parents (chérir ses proches); jouir de la paix; profiter de la bonne fortune"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "fr-FR", "route": "", "translation": {
      "citations": [
        { "citation": "idu77whs", "lang": "fr", "page": "49", "plate": "", "url": "" }
      ], "text": "Grande Sagesse, Piété filiale, Joie et Bonne Fortune"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "fr-FR", "route": "", "translation": {
      "citations": [
        { "citation": "g24mcucr", "lang": "fr", "page": "85", "plate": "", "url": "" }
      ], "text": "Rechercher les hommes sages, aimer ses parents, jouir de la sérénité, profiter de la bonne fortune"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "fr-FR", "route": "", "translation": {
      "citations": [
        { "citation": "hq8n5n8z", "lang": "fr", "page": "76", "plate": "", "url": "" }
      ], "text": "Estimer les sages, aimer ses parents, cultiver la joie, profiter de la chance"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "ja-JP", "route": "", "translation": {
      "citations": [
        { "citation": "oicprxpn", "lang": "ja", "page": "19", "plate": "", "url": "" }
      ], "text": "賢人を贅人として待遇し、親族は親族として扱ぃ、人民の楽を楽と考之、人民の利益を利益と考之る"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "ja-JP", "route": "", "translation": {
      "citations": [
        { "citation": "yo8nlu7d", "lang": "ja", "page": "122", "plate": "", "url": "" }
      ], "text": "賢者に感謝し、両親を愛し、快楽を楽しみ、実りから利益を得る"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "vi-VN", "route": "", "translation": {
      "citations": [
        { "citation": "52xcxi30", "lang": "vi", "page": "47", "plate": "", "url": "" },
        { "citation": "f9ewv5w2", "lang": "vi", "page": "167", "plate": "", "url": "" },
        { "citation": "d3ajayqe", "lang": "vi", "page": "11", "plate": "", "url": "" }
      ], "text": "Hiên với người hiên, thân với người thân, vui cái vui, lợi cái lợi"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "vi-VN", "route": "", "translation": {
      "citations": [
        { "citation": "ybuwdjsb", "lang": "vi", "page": "69", "plate": "", "url": "" },
        { "citation": "twunhs0e", "lang": "vi", "page": "75", "plate": "", "url": "" }
      ], "text": "Quý người hiền, thân người thân"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "vi-VN", "route": "", "translation": {
      "citations": [
        { "citation": "zv1eosh2", "lang": "vi", "page": "47", "plate": "", "url": "" },
        { "citation": "f9ewv5w2", "lang": "vi", "page": "201", "plate": "", "url": "" },
        { "citation": "4i4d9qv0", "lang": "vi", "page": "839", "plate": "", "url": "" }
      ], "text": "Thân với ngườì thân, yêu quý ngườì hiền, lợi diều đáng lợi, vui diều đáng vui"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "vi-VN", "route": "", "translation": {
      "citations": [
        { "citation": "p5x51tts", "lang": "vi", "page": "", "plate": "", "url": "" }
      ], "text": "Mến người hiền, yêu người thân, thưởng thức niềm vui, hưởng ích từ những điều lợi"
    }, "type": "maxim" },
    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "zh-Hans", "route": "", "translation": {
      "citations": [
        { "citation": "rdvlih5h", "lang": "zh", "page": "", "plate": "", "url": "" }
