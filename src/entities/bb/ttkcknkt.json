    { "active": "1", "code": "", "identifier": "", "image": "", "lang": "en-GB", "route": "", "translation": {
      "citations": [
        { "citation": "54q4hlvb", "lang": "en", "page": "115", "plate": "", "url": "" }
      ], "text": "Engraved and chiselled are the ornaments of metal and of jade is their substance"
